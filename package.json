{
  "name": "pr-quick-link",
  "version": "1.0.0",
  "description": "GitHubのプルリクエストのタイトルとリンクを素早くコピーできるChrome拡張機能（Slack、Notion、Google Docsなどで使用可能）",
  "scripts": {
    "build": "tsc && pnpm run copy-assets",
    "copy-assets": "cp src/manifest.json dist/ && cp src/styles.css dist/",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@types/chrome": "^0.0.270",
    "@types/node": "^24.9.2",
    "@vitest/ui": "^4.0.5",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.1.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.5"
  },
  "keywords": [
    "chrome-extension",
    "github",
    "slack",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
