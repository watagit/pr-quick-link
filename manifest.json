{
  "manifest_version": 3,
  "name": "Copy PR Title with Link",
  "version": "1.0.0",
  "description": "GitHub PRのタイトルをSlack形式のリンクとしてコピーできるChrome拡張機能",
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/pull/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
